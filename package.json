{
  "name": "mentegraf",
  "version": "2.3.0",
  "description": "Author's Visual Knowledge Graph Tool",
  "main": "src/main.js",
  "author": "Afif Say",
  "license": "MIT",
  "homepage": "https://www.afifsay.org",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder",
    "build:cm": "node tools/build-codemirror.mjs",
    "test": "node test/projectStore.test.js && node test/exporter.test.js && node test/styles.test.js && node test/compiler.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0"
  },
  "build": {
    "appId": "org.afifsay.mentegraf",
    "productName": "Mentegraf",
    "copyright": "Copyright © 2026 Afif Say",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "src/",
        "to": "src/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "fileAssociations": [
      {
        "ext": "mentegraf",
        "name": "Mentegraf Project",
        "description": "Mentegraf Knowledge Graph Project",
        "mimeType": "application/x-mentegraf",
        "role": "Editor"
      }
    ]
  }
}
